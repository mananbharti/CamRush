{
  "name": "camrush",
  "version": "1.0.0",
  "private": true,
  "description": "CamRush - camera-controlled arcade for Tech Utsav",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup-assets.mjs",
    "postinstall": "node scripts/setup-assets.mjs",
    "dev": "vite --host",
    "build": "vite build",
    "start": "vite build && vite preview --host --port 4173",
    "check": "node scripts/setup-assets.mjs --check",
    "prestart": "node scripts/setup-assets.mjs --check",
    "test": "node tests/expansion.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "@mediapipe/tasks-vision": "^1.1.0"
  },
  "devDependencies": {
    "vite": "^8.3.4"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
